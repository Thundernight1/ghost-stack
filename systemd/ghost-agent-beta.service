[Unit]
Description=GHOST-STACK AGENT-BETA Firewall Observer
Documentation=https://ghost-stack.internal/docs/agent-beta
After=ghost-orchestrator.service network.target
BindsTo=ghost-orchestrator.service
PartOf=ghost-orchestrator.service

[Service]
Type=simple
# agent-beta takes NO command-line flags — all configuration is via
# environment (see cmd/agent-beta/main.go). The paths below match the
# binary's compiled-in defaults AND the orchestrator's pinned-map
# locations (/sys/fs/bpf/ghost-stack/…); keep them in sync.
ExecStart=/opt/ghost-stack/bin/agent-beta
Environment=GHOST_NFLOG_GROUP=1
Environment=GHOST_L2_PERF_MAP=/sys/fs/bpf/ghost-stack/l2_events
Environment=GHOST_L3_DROP_MAP=/sys/fs/bpf/ghost-stack/l3_drops
Environment=GHOST_ALERT_SOCKET=/var/run/ghost-stack/alert.sock
Restart=on-failure
RestartSec=3

# AGENT-BETA needs more capabilities than ALPHA for firewall monitoring.
User=ghost-agent
Group=ghost-agent
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes

# Capabilities: BPF for map access, NET_ADMIN for nflog, PERFMON for perf events.
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_NET_ADMIN
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_NET_ADMIN

# Allow network access for nflog netlink socket.
RestrictAddressFamilies=AF_UNIX AF_NETLINK

# Read-only filesystem access.
ReadOnlyPaths=/
ReadWritePaths=/var/run/ghost-stack/alert.sock

# Logging.
StandardOutput=null
StandardError=journal
SyslogIdentifier=ghost-agent-beta

# Resource limits — AGENT-BETA tracks up to 50K attacker profiles.
MemoryMax=1G
CPUQuota=50%
TasksMax=32

[Install]
WantedBy=ghost-orchestrator.service
